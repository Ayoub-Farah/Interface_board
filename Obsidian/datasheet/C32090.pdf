         <xmp:MetadataDate>2020-08-26T13:17:55+02:00</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NC7SZ04 - TinyLogic UHS Inverter</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ON Semiconductor</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NC7SZ04 is a single inverter from ON Semiconductor's Ultra-High Speed (UHS) series of TinyLogic. The device is fabricated with advanced CMOS technology to achieve ultra-high speed with high output drive while maintaining low static power dissipation over a broad VCC operating range. The device is specified to operate over the 1.65 V to 5.5 V VCC operating range. The inputs and output are high-impedance when VCC is 0 V. Inputs tolerate voltages up to 5.5 V, independent of VCC operating voltage.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 18.0 (Windows)</pdf:Producer>
         <xmpMM:DocumentID>uuid:70a9de29-f76e-4ede-be85-ace2537ab3a5</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:7a7ab5e5-093e-4c3d-97d2-432cc383cd2f</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
