	(text "Normal operation (all bucks OK):\n- PG lines pulled high by R154\n- LD1 (red LED)and D3 OFF\n- U24 / U25 outputs Hi-Z\n- LD2 (green LED) ON\n\nFault condition (any buck NOT OK):\n- PG line pulled low\n- LD1 and D3 ON\n- U24 / U25 outputs LOW -> Enable Reset\n- LD2 OFF"
		(exclude_from_sim no)
		(at 267.462 50.292 0)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
			)
		)
		(uuid "12f64d36-e5c0-412c-aef0-ff53eae1945f")
	)
	(text "POWER OK"
		(exclude_from_sim no)
		(at 239.776 48.006 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1ec409b4-5c09-4292-b719-4b550e8265e4")
	)
	(text "Power Good (PG) behavior:\n\n- Buck OK (correct Vout)    : open-drain output (line pulled high)\n- Buck NOT OK               : line pulled low\n\nU24 / U25 behavior:\n- Input high                : high impedance output\n- Input low                 : output pulled low"
		(exclude_from_sim no)
		(at 214.376 21.336 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "246946cb-0949-42ed-b508-e2c58e15445a")
	)
