	(bus_alias "AUX_CLK"
		(members "REF_CLK0_P" "REF_CLK0_N" "CLK2")
	)
	(bus_alias "WR_CLK"
		(members "WR_CLK0_P" "WR_CLK0_N" "CLK_25MHZ" "CLK20_VCXO")
	)
	(text "Y2 is an optional 25 MHz WR VCTCXO.\nWR_DAC_OUT1 tunes the VC pin. It output a CMOS\nclock compatible with U16 input XIN. "
		(exclude_from_sim no)
		(at 125.222 75.946 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0701d937-bd7e-47ce-9524-384c339760dc")
	)
	(text "1"
		(exclude_from_sim no)
		(at 189.23 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "084fd981-5a3b-40ad-b685-0bced94da82e")
	)
	(text "1"
		(exclude_from_sim no)
		(at 189.23 58.42 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1ba9a881-d28b-4dc3-a755-44d4deeb3cb9")
	)
	(text "U16 is pin-strapped for 25 MHz input and 125 MHz output.\nAll config have a pull resistor.\nPR[1:0] = 11 gives P = 4 and N = 20.\nOD[2:0] = 011 gives /4, so fOUT = 25 MHz x 20 / 4 / 4 = 125 MHz.\nOS[1:0] = 11 selects LVPECL and enables OSC_OUT.\nSee CDCM61002 datasheet"
		(exclude_from_sim no)
		(at 172.466 95.504 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3bc7960d-1489-4272-9c65-8e4c8192f301")
	)
	(text "0"
		(exclude_from_sim no)
		(at 189.23 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4347b69e-9ffa-43c4-9da8-c0395c68c8a9")
	)
	(text "U14 and U15 convert WR_DAC commands into analog control voltages for the VCXOs."
		(exclude_from_sim no)
		(at 45.974 89.408 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7cbf6d4c-2627-4a68-9c36-1e16fab4946c")
	)
	(text "U16 input can receive a DC coupled\nLVCMOS 3V3 input or a AC coupled \n2.5V input. "
		(exclude_from_sim no)
		(at 158.75 19.558 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8defbcfd-7ea8-4bf5-9003-80f852e83d9e")
	)
	(text "U13 provides the precision 2.5 V reference \nused by both DACs (U14 and U15)."
		(exclude_from_sim no)
		(at 24.13 140.716 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "97037407-a07e-4f42-b267-be7f9b266b9f")
	)
	(text "Y1 is the main 25 MHz WR VCTCXO.\nWR_DAC_OUT1 tunes the VC pin. It output a\nclipped sined output.\nIt needs to be converted into LVCMOS to be compatible\nwith U16 XIN input (done by inverter U30)."
		(exclude_from_sim no)
		(at 17.272 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9c26b019-fdf6-4988-8169-410f49d2424e")
	)
	(text "U3 is an I2C-programmable 3-output clock generator \nreferenced to the 25 MHz crystal Y6."
		(exclude_from_sim no)
		(at 209.804 163.068 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9dc3bc9c-b12f-402e-bcf4-c6a5890d74b4")
	)
	(text "1"
		(exclude_from_sim no)
		(at 189.23 45.72 0)
		(effects
