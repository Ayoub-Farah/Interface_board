	(text "Revison: ${rev}\n000 - rev: ${rev}\n\nxx0 - R164 - P05\nx0x - R165 - P06\n0xx - R166 - P07"
		(exclude_from_sim no)
		(at 275.082 99.568 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "11cf0195-8cd5-4131-9853-b6eca25b71d2")
	)
	(text "Low-Speed SFP signals are handled by an I2C GPIO expander. \nAll ports power up as inputs, so external bias resistors define the startup state."
		(exclude_from_sim no)
		(at 310.896 60.452 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1dbe51bf-a3fd-4bdf-932e-8d16bb3b3a59")
	)
	(text "Board revision code"
		(exclude_from_sim no)
		(at 286.004 91.44 0)
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.3)
				(bold yes)
			)
		)
		(uuid "b0b97f8d-f3dc-4c0b-944f-e4b77ad2c4d3")
	)
	(text "The original components was TCA9535, which was not available on \nLCSC. It was replaced with TCA9555, the difference is that \nTCA9555 already has internal pull-up resistor.\nSo resistor R21-R27 are not necessary, but we let them here\nin case we put back a TCA9535.  "
		(exclude_from_sim no)
		(at 310.642 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cf7a9160-aeee-4a4e-868f-9053c2d92f98")
	)
	(text "INT is a pin that can send interruption\nwhen data is ready to be sent."
		(exclude_from_sim no)
		(at 352.044 118.872 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dc3d9696-7424-42d1-a888-d4bf5e87d4f6")
	)
	(text "- RD± are serial outputs and TD± are serial inputs. Route as controlled-impedance 100 Ω differential pairs.\n- VccR and VccT are 3.3 V receiver and transmitter supplies.\n- VeeR and VeeT are module signal grounds.\n- TX_FAULT is an open-drain module status output. High indicates a transmitter fault and requires a pull-up.\n- TX_DISABLE is an input. High disables the transmitter; low enables normal operation.\n- RX_LOS is an open-drain status output. High indicates loss of received optical signal.\n- RS0 and RS1 are rate-select inputs for the receiver and transmitter, they are tied together to have the same rate for both of them."
		(exclude_from_sim no)
		(at 123.952 55.626 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f5d7ada6-d409-4860-87d8-ba70a65627c7")
	)
